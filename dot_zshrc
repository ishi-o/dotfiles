### START_ZPLUG
. "$HOME/.config/shell/msys2-path"

if [[ -n "${WT_SESSION:-}" ]]; then
  __wt_report_cwd() {
    local wt_cwd="$PWD"
    if command -v cygpath >/dev/null 2>&1; then
      wt_cwd="$(cygpath -w "$PWD")"
    fi
    printf '\e]9;9;"%s"\e\\' "$wt_cwd"
  }
  if (( ! ${precmd_functions[(Ie)__wt_report_cwd]} )); then
    precmd_functions+=(__wt_report_cwd)
  fi
fi

if [ ! -f "$USR_HOME/zplug/init.zsh" ]; then
  if command -v git >/dev/null 2>&1; then
    mkdir -p "$(dirname "$USR_HOME/zplug")"
    git clone --depth 1 https://github.com/zplug/zplug "$USR_HOME/zplug"
  fi
fi
if [ ! -f "$USR_HOME/zplug/init.zsh" ]; then
  zplug() { return 0; }
else
  export ZPLUG_HOME="$USR_HOME/zplug"
  export PATH="$ZPLUG_HOME/bin:$PATH"
  source "$ZPLUG_HOME/init.zsh"
fi

## START_OHMYZSH
ZSH_THEME="gozilla"
# ZSH_THEME="simple"
# ZSH_THEME="gnzh"
zplug "ohmyzsh/ohmyzsh", use:"oh-my-zsh.sh", defer:0

zplug "plugins/git",       from:oh-my-zsh, defer:1
zplug "plugins/z",         from:oh-my-zsh, defer:1
zplug "plugins/sudo",      from:oh-my-zsh, defer:1
zplug "plugins/extract",   from:oh-my-zsh, defer:1
zplug "plugins/fzf",       from:oh-my-zsh, defer:1
# for gradle wrapper completions
zplug "plugins/gradle",    from:oh-my-zsh, ignore:"gradle.plugin.zsh", defer:1

VI_MODE_RESET_PROMPT_ON_MODE_CHANGE=true
VI_MODE_SET_CURSOR=true
zplug "plugins/vi-mode",   from:oh-my-zsh, defer:2
## END_OHMYZSH

## START_SYNTAX_HIGHLIGHT
zplug "zsh-users/zsh-syntax-highlighting", defer:2
## END_SYNTAX_HIGHLIGHT

## START_AUTOSUGGESTION
zplug "zsh-users/zsh-autosuggestions", defer:2
## END_AUTOSUGGESTION

## START_COMPLETIONS
zplug "zsh-users/zsh-completions", defer:2
zplug "Aloxaf/fzf-tab", defer:2
## END_COMPLETIONS

## START_ZSHVIMODE
# ZVM_VI_INSERT_ESCAPE_BINDKEY=jj
# zplug "jeffreytse/zsh-vi-mode", defer:2
## END_ZSHVIMODE

if ! zplug check; then
    printf "Install? [y/N]: "
    if read -q; then
        echo; zplug install
    fi
fi
zplug load
### END_ZPLUG

# User configuration

[ -f "$XDG_CONFIG_HOME/fzf/fzf.zsh" ] && source "$XDG_CONFIG_HOME/fzf/fzf.zsh"
source "$XDG_CONFIG_HOME/zsh/keybinds.zsh"
source "$XDG_CONFIG_HOME/zsh/kitty.zsh"

case ":$PATH:" in
  *":$MISE_DATA_DIR/shims:"*) ;;
  *) export PATH="$MISE_DATA_DIR/shims:$PATH" ;;
esac

### START_ALIAS 
alias vi='nvim'
alias vim='nvim'
### END_ALIAS

### START_NVM
if [ -n "${USERPROFILE:-}" ] && command -v cygpath >/dev/null 2>&1; then
  _npm_prefix="$HOME/scoop/persist/nvm/.nodejs"
  if [ ! -d "$_npm_prefix" ]; then
    _npm_prefix="${NVM_SYMLINK:-}"
  fi
  if [ -z "$_npm_prefix" ] && command -v npm >/dev/null 2>&1; then
    _npm_prefix="$(npm config get prefix 2>/dev/null)"
  fi
  if [ -n "$_npm_prefix" ]; then
    _npm_prefix="$(cygpath -u "$_npm_prefix" 2>/dev/null)"
    if [ -d "$_npm_prefix" ]; then
      case ":$PATH:" in
        *":$_npm_prefix:"*) ;;
        *) export PATH="$_npm_prefix:$PATH" ;;
      esac
    fi
  fi
  unset _npm_prefix
else
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"

  _nvm_ver="$(cat "$NVM_DIR/alias/default" 2>/dev/null)"
  if [ -n "$_nvm_ver" ]; then
    for _d in "$NVM_DIR/versions/node/v${_nvm_ver#v}"*; do
      if [ -d "$_d/bin" ]; then
        case ":$PATH:" in
          *":$_d/bin:"*) ;;
          *) export PATH="$_d/bin:$PATH" ;;
        esac
        break
      fi
    done
  fi
  unset _nvm_ver _d

  _nvm_lazy_load() {
    unset -f _nvm_lazy_load nvm
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" --no-use
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
    nvm use --silent default >/dev/null 2>&1
    hash -r
  }

  nvm() { _nvm_lazy_load; command nvm "$@"; }
fi
### END_NVM

. "$XDG_CONFIG_HOME/shell/completions"
compdef _gradle gradlew ./gradlew
compdef -d gradle gw
