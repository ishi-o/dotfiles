### START_ZPLUG
. "$HOME/.config/shell/msys2-path"

if [ ! -f "$USR_HOME/zplug/init.zsh" ]; then
  if command -v git >/dev/null 2>&1; then
    mkdir -p "$(dirname "$USR_HOME/zplug")"
    git clone --depth 1 https://github.com/zplug/zplug "$USR_HOME/zplug"
  fi
fi
if [ ! -f "$USR_HOME/zplug/init.zsh" ]; then
  zplug() { return 0; }
else
  export ZPLUG_HOME="$USR_HOME/zplug"
  export PATH="$ZPLUG_HOME/bin:$PATH"
  source "$ZPLUG_HOME/init.zsh"
fi

## START_OHMYZSH
ZSH_THEME="gozilla"
# ZSH_THEME="simple"
# ZSH_THEME="gnzh"
zplug "ohmyzsh/ohmyzsh", use:"oh-my-zsh.sh", defer:0

zplug "plugins/git",       from:oh-my-zsh, defer:1
zplug "plugins/z",         from:oh-my-zsh, defer:1
zplug "plugins/sudo",      from:oh-my-zsh, defer:1
zplug "plugins/extract",   from:oh-my-zsh, defer:1
zplug "plugins/fzf",       from:oh-my-zsh, defer:1
# for gradle wrapper completions
zplug "plugins/gradle",    from:oh-my-zsh, ignore:"gradle.plugin.zsh", defer:1

VI_MODE_RESET_PROMPT_ON_MODE_CHANGE=true
VI_MODE_SET_CURSOR=true
zplug "plugins/vi-mode",   from:oh-my-zsh, defer:2
## END_OHMYZSH

## START_SYNTAX_HIGHLIGHT
zplug "zsh-users/zsh-syntax-highlighting", defer:2
## END_SYNTAX_HIGHLIGHT

## START_AUTOSUGGESTION
zplug "zsh-users/zsh-autosuggestions", defer:2
## END_AUTOSUGGESTION

## START_COMPLETIONS
zplug "zsh-users/zsh-completions", defer:2
zplug "Aloxaf/fzf-tab", defer:2
## END_COMPLETIONS

## START_ZSHVIMODE
# ZVM_VI_INSERT_ESCAPE_BINDKEY=jj
# zplug "jeffreytse/zsh-vi-mode", defer:2
## END_ZSHVIMODE

if ! zplug check; then
    printf "Install? [y/N]: "
    if read -q; then
        echo; zplug install
    fi
fi
zplug load
### END_ZPLUG

# User configuration

[ -f "$XDG_CONFIG_HOME/fzf/fzf.zsh" ] && source "$XDG_CONFIG_HOME/fzf/fzf.zsh"
source "$XDG_CONFIG_HOME/zsh/keybinds.zsh"
source "$XDG_CONFIG_HOME/zsh/kitty.zsh"

mise_path="$(command -v mise 2>/dev/null || true)"
if [ -z "$mise_path" ] && [ -x "$MISE_INSTALL_PATH" ]; then
  mise_path="$MISE_INSTALL_PATH"
fi
if [ -n "$mise_path" ]; then
  eval "$("$mise_path" activate zsh)"
fi
unset mise_path

### START_ALIAS 
alias vi='nvim'
alias vim='nvim'
### END_ALIAS

### START_NVM
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"                   # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion" # This loads nvm bash_completion
command -v nvm >/dev/null 2>&1 && nvm use --silent default >/dev/null 2>&1
### END_NVM

fpath=(
    $XDG_CONFIG_HOME/zfunc
    $fpath
)
autoload -Uz compinit && compinit
compdef _gradle gradlew ./gradlew
compdef -d gradle gw
