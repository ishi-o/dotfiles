{{- if and (eq .chezmoi.os "linux") (env "WSL_DISTRO_NAME") (stat "/mnt/wslg") }}
# WSLg does not configure a Wayland input-method service by default. Keep Kitty
# on XWayland so it can use Fcitx's X11/IBus compatibility frontend.
linux_display_server x11
{{- end }}

### LAYOUT
enabled_layouts splits,stack
### LAYOUT

### CURSOR
cursor_shape block
cursor_blink_interval 0.5
cursor #3A5B7E
cursor_text_color background
### CURSOR

### TEXT
adjust_line_height 0
adjust_baseline 0
adjust_column_width 0
### TEXT

### REMOTE_SSH
allow_remote_control yes
listen_on unix:/tmp/kitty
shell_integration enabled
shell_integration no-cursor
### REMOTE_SSH

### CLIPBOARD
clipboard_control write-clipboard write-primary read-clipboard read-primary
### CLIPBOARD

# KITTY_FONTS
font_family      family="Consolas ligaturized v3"
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size 18
# KITTY_FONTS

# AUTO_SESSION
startup_session ~/.config/kitty/sessions/last.kitty-session
# AUTO_SESSION

### MAPPING
map f11 toggle_fullscreen
map ctrl+shift+s save_as_session --use-foreground-process --save-only ~/.config/kitty/sessions/last.kitty-session

map ctrl+j neighboring_window down
map ctrl+k neighboring_window up
map ctrl+h neighboring_window left
map ctrl+l neighboring_window right

map --when-focus-on var:IS_NVIM ctrl+j
map --when-focus-on var:IS_NVIM ctrl+k
map --when-focus-on var:IS_NVIM ctrl+h
map --when-focus-on var:IS_NVIM ctrl+l

# the 3 here is the resize amount, adjust as needed
map alt+j kitten relative_resize.py down  3
map alt+k kitten relative_resize.py up    3
map alt+h kitten relative_resize.py left  3
map alt+l kitten relative_resize.py right 3

map --when-focus-on var:IS_NVIM alt+j
map --when-focus-on var:IS_NVIM alt+k
map --when-focus-on var:IS_NVIM alt+h
map --when-focus-on var:IS_NVIM alt+l

# Window splitting
map ctrl+\ launch --location=vsplit
map ctrl+- launch --location=hsplit
### MAPPING

### MACOS_OPTION_AS_ALT
macos_option_as_alt yes
### MACOS_OPTION_AS_ALT
