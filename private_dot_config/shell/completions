# Keep Bash and Zsh completion behavior aligned for the tools this dotfiles
# repository installs or expects to be available.

if [ -n "${ZSH_VERSION:-}" ]; then
    fpath=(
        "$XDG_CONFIG_HOME/zfunc"
        "$XDG_DATA_HOME/zsh/site-functions"
        $fpath
    )
    autoload -Uz compinit
    compinit -C
elif [ -n "${BASH_VERSION:-}" ]; then
    if [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    elif [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    fi

    if [ -d "$XDG_CONFIG_HOME/bash/completions" ]; then
        for completion in "$XDG_CONFIG_HOME/bash/completions"/*.bash; do
            [ -f "$completion" ] && . "$completion"
        done
    fi
    unset completion

    if [ -r "$XDG_DATA_HOME/bash-completion/completions/cc-switch" ]; then
        . "$XDG_DATA_HOME/bash-completion/completions/cc-switch"
    fi
fi
