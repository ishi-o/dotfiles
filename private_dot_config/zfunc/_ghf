#compdef ghf

_ghf() {
  local -a commands
  commands=(
    'n:notifications'
    'notif:notifications'
    'notifications:notifications'
    'r:repositories'
    'repo:repositories'
    'repos:repositories'
    'repositories:repositories'
    'i:issues'
    'issue:issues'
    'issues:issues'
    'p:pull requests'
    'pr:pull requests'
    'prs:pull requests'
    'pulls:pull requests'
    'a:actions'
    'action:actions'
    'actions:actions'
    'menu:open the main menu'
    'help:show help'
    '--help:show help'
    '-h:show help'
  )

  if (( CURRENT == 2 )); then
    _describe 'ghf command' commands
    return
  fi

  case "${words[2]}" in
    i|issue|issues|p|pr|prs|pulls|a|action|actions)
      _message 'repository (owner/name)'
      ;;
  esac
}

compdef _ghf ghf
