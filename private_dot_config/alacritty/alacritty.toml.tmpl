[cursor]
blink_interval = 500

[cursor.style]
shape = "Block"
blinking = "Always"

[font]
size = {{ .fontSize }}.0

[font.normal]
family = "Consolas"

[font.glyph_offset]
x = 0
y = -2

[window]
opacity = {{ default "0.8" .transparency }}
option_as_alt = "Both"

[colors.primary]
background = "#f3ead3"
foreground = "#5c6a72"

[colors.cursor]
text = "#eae4ca"
cursor = "#5c6a72"

[colors.selection]
background = "#e1e4bd"
text = "#829181"

[colors.normal]
black = "#708089"
red = "#f85552"
green = "#8da101"
yellow = "#dfa000"
blue = "#3a94c5"
magenta = "#df69ba"
cyan = "#35a77c"
white = "#939f91"

[colors.bright]
black = "#829181"
red = "#e66868"
green = "#93b259"
yellow = "#dfa000"
blue = "#3a94c5"
magenta = "#df69ba"
cyan = "#35a77c"
white = "#a6b0a0"

[[keyboard.bindings]]
key = "F11"
action = "ToggleFullscreen"
