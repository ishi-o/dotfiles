#!/usr/bin/env bash

set -euo pipefail

os="{{ .chezmoi.os }}"
arch="{{ if eq .chezmoi.arch "amd64" }}x86_64{{ else }}{{ .chezmoi.arch }}{{ end }}"

if [ "$os" != "darwin" ] && [ "$os" != "linux" ]; then
  echo "Unsupported OS: $os"
  exit 1
fi

if command -v nvim >/dev/null 2>&1; then
  nvim_destination="$(realpath "$(command -v nvim)" | sed 's#/bin/nvim$##')"
else
  nvim_destination="$HOME/.local/opt/nvim"
fi

latest_release="${LATEST_RELEASE:-nightly}"
download_url="https://github.com/neovim/neovim/releases/download/${latest_release}/nvim-${os}-${arch}.tar.gz"

install_dir="$(chezmoi source-path)"
source "$install_dir/.chezmoi-install/lib/posix/env.sh"
source "$install_dir/.chezmoi-install/lib/posix/helpers.sh"

temp_dir="${nvim_destination}.tmp.$$"
mkdir -p "$temp_dir"

echo "Downloading and extracting nvim to $temp_dir..."
download_extract "$download_url" "$temp_dir" --strip-components=1

rm -rf "$nvim_destination"
mv "$temp_dir" "$nvim_destination"

echo "Nvim upgraded to $latest_release"
