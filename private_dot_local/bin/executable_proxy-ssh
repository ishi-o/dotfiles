#!/usr/bin/env sh
set -eu

[ "$#" -eq 2 ] || {
  echo "usage: proxy-ssh HOST PORT" >&2
  exit 2
}

host="$1"
port="$2"
config="${XDG_CONFIG_HOME:-$HOME/.config}/proxy/config"
if [ -r "$config" ]; then
  . "$config"
fi
PROXY_SOCKS="${PROXY_SOCKS:-}"

if [ -z "$PROXY_SOCKS" ]; then
  exec nc "$host" "$port"
fi

proxy="${PROXY_SOCKS#*://}"
case "$PROXY_SOCKS" in
  socks5://*|socks5h://*)
    exec nc -X 5 -x "$proxy" "$host" "$port"
    ;;
  http://*|https://*)
    exec nc -X connect -x "$proxy" "$host" "$port"
    ;;
  *)
    echo "proxy-ssh: unsupported proxy URL: $PROXY_SOCKS" >&2
    exit 1
    ;;
esac
