{{- $origin := output "git" "-C" .chezmoi.sourceDir "remote" "-v" -}}
{{- $useSSH := regexMatch "(?m)^origin[[:space:]]+(git@|ssh://|git\\+ssh://)" $origin -}}
{{- $usrHome := or (env "USR_HOME") (joinPath .chezmoi.homeDir "usr/local") -}}
{{- $usrHomeRel := trimPrefix (printf "%s/" .chezmoi.homeDir) $usrHome -}}
{{- $installFontsValue := lower (or (env "INSTALL_FONTS") "true") -}}
{{- $installFonts := not (or (eq $installFontsValue "false") (eq $installFontsValue "0") (eq $installFontsValue "no") (eq $installFontsValue "off")) -}}
[".config/nvim"]
type = "git-repo"
{{ if $useSSH }}
url = "git@github.com:ishi-o/ishio.nvim.git"
{{ else }}
url = "https://github.com/ishi-o/ishio.nvim.git"
{{ end }}

{{ if $installFonts }}
[yahei_consolas_hybrid]
type = "file"
url = "https://raw.githubusercontent.com/Magnetic2014/YaHei-Consolas-Hybrid-For-Powerline/master/YaHei%20Consolas%20Hybrid%201.12%20For%20Powerline.ttf"
{{ if eq .chezmoi.os "darwin" }}
targetPath = "Library/Fonts/YaHei Consolas Hybrid 1.12 For Powerline.ttf"
{{ else if eq .chezmoi.os "linux" }}
targetPath = ".local/share/fonts/YaHei Consolas Hybrid 1.12 For Powerline.ttf"
{{ else if eq .chezmoi.os "windows" }}
targetPath = "AppData/Local/Microsoft/Windows/Fonts/YaHei Consolas Hybrid 1.12 For Powerline.ttf"
{{ end }}

[maple_mono_normal]
type = "archive"
url = "https://github.com/subframe7536/maple-font/releases/download/v7.9/MapleMonoNormal-TTF.zip"
{{ if eq .chezmoi.os "darwin" }}
targetPath = "Library/Fonts"
{{ else if eq .chezmoi.os "linux" }}
targetPath = ".local/share/fonts"
{{ else if eq .chezmoi.os "windows" }}
targetPath = "AppData/Local/Microsoft/Windows/Fonts"
{{ end }}
include = ["MapleMonoNormal*.ttf"]
{{ end }}
