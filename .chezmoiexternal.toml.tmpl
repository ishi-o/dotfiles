{{- $origin := output "git" "-C" .chezmoi.sourceDir "remote" "-v" -}}
{{- $useSSH := regexMatch "(?m)^origin[[:space:]]+(git@|ssh://|git\\+ssh://)" $origin -}}
{{- $usrHome := or (env "USR_HOME") (joinPath .chezmoi.homeDir "usr/local") -}}
{{- $usrHomeRel := trimPrefix (printf "%s/" .chezmoi.homeDir) $usrHome -}}
[".config/nvim"]
type = "git-repo"
{{ if $useSSH }}
url = "git@github.com:ishi-o/ishio.nvim.git"
{{ else }}
url = "https://github.com/ishi-o/ishio.nvim.git"
{{ end }}

[consolas_ligaturized]
type = "archive"
url = "https://github.com/somq/consolas-ligaturized/archive/refs/tags/3.1.tar.gz"
{{ if eq .chezmoi.os "darwin" }}
targetPath = "Library/Fonts"
{{ else if eq .chezmoi.os "linux" }}
targetPath = ".local/share/fonts"
{{ end }}
stripComponents = 1
include = ["*/Consolasligaturizedv3*.ttf"]
