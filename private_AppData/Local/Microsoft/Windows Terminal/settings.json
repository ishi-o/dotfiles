{
  "$schema": "https://aka.ms/terminal-profiles-schema",
  "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
  "launchMode": "maximized",
  "copyOnSelect": true,
  "copyFormatting": "none",
  "theme": "system",
  "profiles": {
    "defaults": {
      "colorScheme": "Everforest Light - Medium",
      "cursorShape": "filledBox",
      "font": {
        "face": "Consolas,Symbols Nerd Font Mono,LXGW WenKai Mono",
        "size": 16
      },
      "opacity": 100,
      "padding": "8",
      "scrollbarState": "hidden",
      "useAcrylic": false
    },
    "list": [
      {
        "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
        "name": "PowerShell",
        "hidden": true
      },
      {
        "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
        "name": "pwsh",
        "commandline": "pwsh.exe -NoLogo",
        "hidden": false
      },
      {
        "guid": "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}",
        "name": "Command Prompt",
        "hidden": true
      },
      {
        "guid": "{2ece5bfe-50ed-5f3a-ab87-5cd4baafed2b}",
        "name": "Git Bash",
        "hidden": false,
        "source": "Git"
      }
    ]
  },
  "actions": [
    {
      "id": "User.toggleFullscreen",
      "command": "toggleFullscreen"
    },
    {
      "id": "User.sendCtrlB",
      "command": {
        "action": "sendInput",
        "input": "\u0002\u0013"
      }
    },
    {
      "id": "User.closePane",
      "command": "closePane"
    },
    {
      "id": "User.swapLeft",
      "command": {
        "action": "swapPane",
        "direction": "left"
      }
    },
    {
      "id": "User.swapDown",
      "command": {
        "action": "swapPane",
        "direction": "down"
      }
    },
    {
      "id": "User.swapUp",
      "command": {
        "action": "swapPane",
        "direction": "up"
      }
    },
    {
      "id": "User.swapRight",
      "command": {
        "action": "swapPane",
        "direction": "right"
      }
    },
    {
      "id": "User.focusLeft",
      "command": {
        "action": "moveFocus",
        "direction": "left"
      }
    },
    {
      "id": "User.focusDown",
      "command": {
        "action": "moveFocus",
        "direction": "down"
      }
    },
    {
      "id": "User.focusUp",
      "command": {
        "action": "moveFocus",
        "direction": "up"
      }
    },
    {
      "id": "User.focusRight",
      "command": {
        "action": "moveFocus",
        "direction": "right"
      }
    },
    {
      "id": "User.resizeLeft",
      "command": {
        "action": "resizePane",
        "direction": "left"
      }
    },
    {
      "id": "User.resizeDown",
      "command": {
        "action": "resizePane",
        "direction": "down"
      }
    },
    {
      "id": "User.resizeUp",
      "command": {
        "action": "resizePane",
        "direction": "up"
      }
    },
    {
      "id": "User.resizeRight",
      "command": {
        "action": "resizePane",
        "direction": "right"
      }
    },
    {
      "id": "User.splitVertical",
      "command": {
        "action": "splitPane",
        "split": "right",
        "splitMode": "duplicate"
      }
    },
    {
      "id": "User.splitHorizontal",
      "command": {
        "action": "splitPane",
        "split": "down",
        "splitMode": "duplicate"
      }
    },
    {
      "id": "User.togglePaneZoom",
      "command": "togglePaneZoom"
    }
  ],
  "keybindings": [
    {
      "keys": "f11",
      "id": "User.toggleFullscreen"
    },
    {
      "keys": "ctrl+shift+s",
      "id": "User.sendCtrlB"
    },
    {
      "keys": "ctrl+shift+d",
      "id": "User.closePane"
    },
    {
      "keys": "ctrl+\\",
      "id": "User.splitVertical"
    },
    {
      "keys": "ctrl+-",
      "id": "User.splitHorizontal"
    },
    {
      "keys": "ctrl+shift+minus",
      "id": "Terminal.DecreaseFontSize"
    },
    {
      "keys": "ctrl+shift+plus",
      "id": "Terminal.IncreaseFontSize"
    },
    {
      "keys": "ctrl+shift+z",
      "id": "User.togglePaneZoom"
    }
  ],
  "schemes": [
    {
      "name": "Everforest Light - Medium",
      "background": "#FDF6E3",
      "foreground": "#5C6A72",
      "cursorColor": "#5C6A72",
      "selectionBackground": "#E0DCC7",
      "black": "#5C6A72",
      "red": "#F85552",
      "green": "#8DA101",
      "yellow": "#DFA000",
      "blue": "#2B6FA0",
      "purple": "#DF69BA",
      "cyan": "#35A77C",
      "white": "#FDF6E3",
      "brightBlack": "#A6B0A0",
      "brightRed": "#F85552",
      "brightGreen": "#6A7D00",
      "brightYellow": "#DFA000",
      "brightBlue": "#2B6FA0",
      "brightPurple": "#DF69BA",
      "brightCyan": "#35A77C",
      "brightWhite": "#FDF6E3"
    }
  ]
}
