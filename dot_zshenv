export USR_HOME="${USR_HOME:-$HOME/usr/local}"
export EDITOR='nvim'
export VISUAL='nvim'
export GOROOT="$USR_HOME/go"
export GOPATH="$HOME/go"
export PATH="$USR_HOME/bin:$PATH"
export PATH="$USR_HOME/kitty.app/bin:$PATH"
export PATH="$USR_HOME/nvim/bin:$PATH"
export PATH="$HOME/.fzf/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/bin:$PATH"
export PATH="$GOROOT/bin:$PATH"
export PATH="$GOPATH/bin:$PATH"
export PATH="$HOME/.local/share/coursier/bin:$PATH"

. "$HOME/.config/env"

# Optional network proxy.
# Examples: http://127.0.0.1:7890 or socks5h://127.0.0.1:1080
# export PROXY_URL="http://127.0.0.1:7890"
if [ -n "${PROXY_URL:-}" ]; then
    export HTTP_PROXY="$PROXY_URL"
    export HTTPS_PROXY="$PROXY_URL"
    export ALL_PROXY="$PROXY_URL"
    export http_proxy="$PROXY_URL"
    export https_proxy="$PROXY_URL"
    export all_proxy="$PROXY_URL"
    export NO_PROXY="${NO_PROXY:-${no_proxy:-localhost,127.0.0.1,::1}}"
    export no_proxy="${no_proxy:-$NO_PROXY}"
fi

# Ensure a working D-Bus session bus.
# WSLg may leave a stale socket; detect and restart if needed.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] || ! dbus-send --session --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.ListNames >/dev/null 2>&1; then
    unset DBUS_SESSION_BUS_ADDRESS
    wslg_bus="/mnt/wslg/run/user/$(id -u)/bus"
    if [ -S "$wslg_bus" ]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=$wslg_bus"
    fi
    if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] || ! dbus-send --session --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.ListNames >/dev/null 2>&1; then
        unset DBUS_SESSION_BUS_ADDRESS
        if command -v dbus-launch >/dev/null 2>&1; then
            eval "$(dbus-launch --sh-syntax)"
        fi
    fi
fi

# Optional graphical/input-method integration.
# On WSL, require WSLg so headless WSL does not start fcitx5.
fcitx5_enabled=false
fcitx5_is_wsl=false
case "$(uname -r 2>/dev/null)" in
    *microsoft*|*Microsoft*|*WSL*) fcitx5_is_wsl=true ;;
esac
[ -n "${WSL_DISTRO_NAME:-}" ] && fcitx5_is_wsl=true

if command -v fcitx5 >/dev/null 2>&1 &&
    { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
    if [ "$fcitx5_is_wsl" = false ] || [ -d /mnt/wslg ]; then
        fcitx5_enabled=true
    fi
fi

if [ "$fcitx5_enabled" = true ]; then
    if [ "$fcitx5_is_wsl" = true ] && [ -d /mnt/wslg ]; then
        # WSLg's Weston does not start a Wayland input-method service by default.
        # Use Fcitx's toolkit/X11-compatible frontends instead.
        export GTK_IM_MODULE=fcitx
        export QT_IM_MODULE=fcitx
        export SDL_IM_MODULE=fcitx
        export XMODIFIERS=@im=fcitx
        if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
            export GLFW_IM_MODULE=ibus
        fi
    elif [ -z "${WAYLAND_DISPLAY:-}" ] && [ -n "${DISPLAY:-}" ]; then
        # X11/XWayland applications use XIM or the toolkit modules.
        export XMODIFIERS=@im=fcitx
        if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
            export GLFW_IM_MODULE=ibus
        fi
    fi
    fcitx5_pid="$(pgrep -xo fcitx5 2>/dev/null)"
    fcitx5_needs_start=true
    if [ -n "$fcitx5_pid" ]; then
        fcitx5_needs_start=false
        if [ "$fcitx5_is_wsl" = true ] && [ -d /mnt/wslg ]; then
            fcitx5_args="$(ps -o args= -p "$fcitx5_pid" 2>/dev/null)"
            case "$fcitx5_args" in
                *"--disable=wayland"*) ;;
                *) fcitx5_needs_start=true ;;
            esac
        fi
    fi
    if [ "$fcitx5_needs_start" = true ]; then
        if [ "$fcitx5_is_wsl" = true ] && [ -d /mnt/wslg ]; then
            nohup fcitx5 --disable=wayland --replace -d >/dev/null 2>&1 &
        else
            nohup fcitx5 -d >/dev/null 2>&1 &
        fi
    fi
fi
unset fcitx5_enabled fcitx5_is_wsl fcitx5_pid fcitx5_args fcitx5_needs_start
